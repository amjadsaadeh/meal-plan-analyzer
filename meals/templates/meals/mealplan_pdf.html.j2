{% load static i18n meal_extras sass_tags %}
<!DOCTYPE html>
<html lang="{{ LANGUAGE_CODE }}">
<head>
    <meta charset="UTF-8">
    <title>{{ plan.name }} - PDF Export</title>
    <link rel="stylesheet" href="{% sass_src 'meals/scss/pdf.scss' %}">
    <style>
        /* Translated page-number strings cannot live in SCSS; kept inline. */
        @page {
            size: A4 portrait;
            margin: 2cm;
            @bottom-center {
                content: "{% trans "Page" %} " counter(page);
                font-family: 'Outfit', sans-serif;
                font-size: 10pt;
            }
        }

        @media screen {
            .summary-page::after {
                content: "{% trans "Page" %} 1";
                position: absolute;
                bottom: 1cm;
                left: 50%;
                transform: translateX(-50%);
                font-size: 10pt;
                color: #666E73;
            }

            .day-container::after {
                content: "{% trans "Page" %} " attr(data-page-index);
                position: absolute;
                bottom: 1cm;
                left: 50%;
                transform: translateX(-50%);
                font-size: 10pt;
                color: #666E73;
            }
        }
    </style>
</head>
<body>

    <div class="export-container no-print">
        <div style="display: flex; gap: 10px; align-items: center;">
            <a href="{% url 'meal-plan-detail' plan.id %}" class="back-link" target="_top">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                {% trans "Back to Plan" %}
            </a>

            <div class="col-select-container">
                <button class="btn-col-select" id="colSelectBtn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    {% trans "Select Nutrients" %}
                </button>
                <div class="col-select-dropdown" id="colDropdown">
                    {% for nutrient in all_nutrients %}
                        {% if nutrient.key != 'energy_in_kcal' %}
                        <label class="col-option">
                            <input type="checkbox" data-key="{{ nutrient.key }}" {% if nutrient.key in plan.visible_nutrients %}checked{% endif %}>
                            {{ nutrient.label }}
                        </label>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
        <a href="{% url 'meal-plan-pdf' plan.id %}" class="export-button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            {% trans "PDF Export" %}
        </a>
    </div>

    <!-- Summary Page -->
    <div class="summary-page">
        <div class="logo-header">
            <img src="{% if logo_path %}{{ logo_path }}{% else %}{% static 'meals/img/logo.png' %}{% endif %}" alt="Meal Plan Analyzer Logo">
        </div>
        <h1>{% trans "Analysis" %}: {{ plan.name }}</h1>
        <div class="subtitle-wrapper">
            <svg class="subtitle-pen no-print" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
            </svg>
            <span class="plan-subtitle"
                  contenteditable="true"
                  data-placeholder="{% trans "Add a subtitle..." %}"
                  id="planSubtitle">{{ plan.subtitle }}</span>
        </div>
        <p><strong>{% trans "Average daily intake" %}</strong> ({% blocktrans with count=days_count %}over {{ count }} days{% endblocktrans %})</p>

        <table class="summary-table">
            <thead>
                <tr>
                    <th>{% trans "Nutrient" %}</th>
                    <th class="text-right">{% trans "Average" %}</th>
                    <th class="text-center">{% trans "Unit" %}</th>
                    <th>{% trans "Reference" %}</th>
                    <th>{% trans "Status" %}</th>
                </tr>
            </thead>
            <tbody>
                {% for nutrient in summary_nutrients %}
                <tr>
                    <td>{{ nutrient.label }}</td>
                    <td class="num-right">{{ nutrient.value|floatformat:1 }}</td>
                    <td class="unit-col">{{ nutrient.unit }}</td>
                    <td class="num-left">
                        {% if nutrient.threshold_label %}
                            {{ nutrient.threshold_label }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td>
                        <div class="bar-container">
                            <div class="bar {% if nutrient.is_ok %}bar-ok{% else %}bar-alert{% endif %}" style="width: {{ nutrient.percentage }}%;"></div>
                        </div>
                        <span class="{% if nutrient.is_ok %}status-ok{% else %}status-alert{% endif %}">
                            {{ nutrient.percentage }}%
                        </span>

                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Day Pages -->
    {% for day in days_data %}
    <div class="day-container" data-page-index="{{ forloop.counter|add:1 }}">
        {% if minilogo_path %}
        <div class="day-minilogo">
            <img src="{{ minilogo_path }}" alt="Logo">
        </div>
        {% endif %}
        <h1>{{ day.name }}</h1>
        
        {% for meal_type, foods in day.meals.items %}
            {% if foods %}
            <h3>{{ meal_type }}</h3>
            <table class="day-table">
                <thead>
                    <tr>
                        <th style="width: auto; min-width: 100px;">{% trans "Food" %}</th>
                        <th style="width: 60px;" class="text-center">{% trans "Amount (g)" %}</th>
                        {% for nutrient in visible_nutrients %}
                            <th class="text-right" style="width: 50px;">{{ nutrient.label }}<br><small>({{ nutrient.unit }})</small></th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for item in foods %}
                    <tr>
                        <td>
                            <span class="food-display-name"
                                  contenteditable="true"
                                  data-mpf-id="{{ item.mpf_id }}"
                                  data-original-name="{{ item.food.name }}"
                            >{% if item.export_name %}{{ item.export_name }}{% else %}{{ item.food.name }}{% endif %}</span>{% if item.export_name %}<span class="renamed-badge no-print">{% trans "renamed" %}<span class="renamed-tooltip">{{ item.food.name }}</span></span>{% endif %}
                        </td>
                        <td class="text-center">{{ item.amount_in_g }}</td>
                        {% for nutrient in visible_nutrients %}
                            <td class="text-right">{{ item.nutrients|get_item:nutrient.key|floatformat:1 }}</td>
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% endif %}
        {% endfor %}

        <!-- Daily Totals could go here if needed, but wasn't explicitly requested for the day detail pages, only summary on top. 
             However, "Each day of the meal plan also got a static table..." usually implies just the list. 
             I'll stick to the list. -->
    </div>
    {% endfor %}

    <script>
        const PLAN_ID = "{{ plan.id }}";
        const CSRF_TOKEN = "{{ csrf_token }}";

        document.getElementById('colSelectBtn').addEventListener('click', (e) => {
            e.stopPropagation();
            document.getElementById('colDropdown').classList.toggle('active');
        });

        document.addEventListener('click', (e) => {
            if (!e.target.closest('#colDropdown')) {
                document.getElementById('colDropdown').classList.remove('active');
            }
        });

        document.querySelectorAll('.col-option input').forEach(input => {
            input.addEventListener('change', async (e) => {
                const visibleNutrients = Array.from(document.querySelectorAll('.col-option input:checked'))
                                              .map(i => i.dataset.key);

                try {
                    const response = await fetch(`/api/mealplans/${PLAN_ID}/`, {
                        method: 'PATCH',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-CSRFToken': CSRF_TOKEN
                        },
                        body: JSON.stringify({ visible_nutrients: visibleNutrients })
                    });

                    if (response.ok) {
                        window.location.reload();
                    }
                } catch (e) { console.error(e); }
            });
        });

        // Subtitle save
        const RENAMED_LABEL = "{% trans 'renamed' %}";
        const planSubtitle = document.getElementById('planSubtitle');
        if (planSubtitle) {
            let savedSubtitle = planSubtitle.innerText.trim();

            planSubtitle.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); planSubtitle.blur(); }
                if (e.key === 'Escape') { planSubtitle.innerText = savedSubtitle; planSubtitle.blur(); }
            });

            planSubtitle.addEventListener('blur', async () => {
                const subtitle = planSubtitle.innerText.trim();
                if (subtitle === savedSubtitle) return;
                try {
                    const res = await fetch(`/api/mealplans/${PLAN_ID}/`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json', 'X-CSRFToken': CSRF_TOKEN },
                        body: JSON.stringify({ subtitle })
                    });
                    if (res.ok) savedSubtitle = subtitle;
                } catch (e) { console.error(e); }
            });
        }

        // Food name rename
        document.querySelectorAll('.food-display-name').forEach(span => {
            const originalName = span.dataset.originalName;
            const mpfId = span.dataset.mpfId;
            let savedExportName = span.innerText.trim() !== originalName ? span.innerText.trim() : '';

            span.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') { e.preventDefault(); span.blur(); }
                if (e.key === 'Escape') {
                    span.innerText = savedExportName || originalName;
                    span.blur();
                }
            });

            span.addEventListener('blur', async () => {
                const text = span.innerText.trim();
                const exportName = (text === '' || text === originalName) ? '' : text;
                if (exportName === savedExportName) return;

                // Restore display if cleared
                if (!text) span.innerText = originalName;

                try {
                    const res = await fetch(`/api/mealplan-foods/${mpfId}/`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json', 'X-CSRFToken': CSRF_TOKEN },
                        body: JSON.stringify({ export_name: exportName })
                    });

                    if (res.ok) {
                        savedExportName = exportName;
                        const td = span.closest('td');
                        let badge = td.querySelector('.renamed-badge');

                        if (exportName) {
                            if (!badge) {
                                badge = document.createElement('span');
                                badge.className = 'renamed-badge no-print';
                                const tooltip = document.createElement('span');
                                tooltip.className = 'renamed-tooltip';
                                tooltip.textContent = originalName;
                                badge.textContent = RENAMED_LABEL;
                                badge.appendChild(tooltip);
                                td.appendChild(badge);
                            }
                        } else {
                            if (badge) badge.remove();
                        }
                    }
                } catch (e) { console.error(e); }
            });
        });
    </script>
</body>
</html>
