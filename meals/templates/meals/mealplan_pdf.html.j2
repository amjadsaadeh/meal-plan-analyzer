{% load static meal_extras %}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <title>{{ plan.name }} - PDF Export</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600&display=swap');

        @page {
            size: A4 portrait;
            margin: 2cm;
            @bottom-center {
                content: "Seite " counter(page);
                font-family: 'Outfit', sans-serif;
                font-size: 10pt;
            }
        }

        @page landscape {
            size: A4 landscape;
            margin: 1.5cm;
        }

        body {
            font-family: 'Outfit', sans-serif;
            color: #2c3338;
            font-size: 11pt;
            line-height: 1.4;
        }

        h1 {
            font-size: 24pt;
            color: #3ba38f;
            margin-bottom: 20px;
            border-bottom: 2px solid #3ba38f;
            padding-bottom: 10px;
        }

        h2 {
            font-size: 18pt;
            color: #3ba38f;
            margin-top: 20px;
            margin-bottom: 15px;
        }

        h3 {
            font-size: 14pt;
            color: #64748b;
            margin-top: 15px;
            margin-bottom: 10px;
            border-bottom: 1px solid #e2e8f0;
            padding-bottom: 5px;
        }

        /* Summary Page */
        .summary-page {
            page: portrait;
        }

        .summary-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-size: 10pt; /* Reduced from 11pt default */
        }

        .summary-table th, .summary-table td {
            padding: 6px 8px; /* Reduced from 10px */
            border: 1px solid #e2e8f0;
            text-align: left;
        }

        .summary-table th {
            background-color: #f8fafc;
            color: #64748b;
            font-weight: 600;
        }

        .bar-container {
            width: 100px;
            height: 10px;
            background-color: #e2e8f0;
            border-radius: 5px;
            overflow: hidden;
            display: inline-block;
            vertical-align: middle;
            margin-right: 10px;
        }

        .bar {
            height: 100%;
            border-radius: 5px;
        }

        .status-ok { color: #10b981; }
        .status-warn { color: #f59e0b; }
        .status-alert { color: #ef4444; }
        
        .bar-ok { background-color: #10b981; }
        .bar-warn { background-color: #f59e0b; }
        .bar-alert { background-color: #ef4444; }

        /* Day Pages */
        .day-container {
            page: landscape;
            page-break-before: always;
        }

        .day-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
            font-size: 9pt; /* Reduced from 10pt */
            table-layout: auto;
        }

        .day-table th, .day-table td {
            padding: 4px 6px; /* Reduced from 8px */
            border: 1px solid #e2e8f0;
            word-wrap: break-word; /* Allow wrapping in cells */
            overflow-wrap: break-word;
            hyphens: auto; /* Enable hyphenation */
        }

        .day-table th {
            background-color: #f8fafc;
            font-weight: 600;
            text-align: left;
            /* Removed white-space: nowrap */
            vertical-align: bottom;
        }

        .day-table td {
            vertical-align: top;
        }

        .text-right { text-align: right; }
        .text-center { text-align: center; }

        .total-row {
            background-color: #f0fdf9;
            font-weight: 600;
        }
        
        .meal-type-header {
            background-color: rgba(59, 163, 143, 0.1) !important;
            color: #2d8170;
            font-size: 12pt;
        }

        .text-right { text-align: right !important; }
        .text-center { text-align: center !important; }

        .num-right {
            text-align: right !important;
            padding-right: 5px !important;
        }
        
        .unit-col {
            text-align: center;
            color: #64748b;
            font-size: 0.9em;
            width: 40px;
        }

        .num-left {
            text-align: left;
            padding-left: 5px !important;
        }

        /* Prevent button from appearing in PDF */
        @media print {
            .no-print {
                display: none !important;
            }
        }

        .export-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            padding: 10px 0;
            color: var(--text-dim, #64748b);
            text-decoration: none;
            font-weight: 400;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: #3ba38f;
        }

        .back-link svg {
            margin-right: 8px;
        }

        .export-button {
            display: inline-flex;
            align-items: center;
            padding: 10px 20px;
            background-color: #3ba38f;
            color: white;
            text-decoration: none;
            border-radius: 8px;
            font-weight: 600;
            transition: background-color 0.2s;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .export-button:hover {
            background-color: #2d8170;
        }

        .export-button svg {
            margin-right: 8px;
        }

        .col-select-container {
            position: relative;
            display: inline-block;
        }

        .col-select-dropdown {
            position: absolute;
            top: 100%;
            left: 0;
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            z-index: 1000;
            padding: 10px;
            display: none;
            width: 220px;
            text-align: left;
        }

        .col-select-dropdown.active {
            display: block;
        }

        .col-option {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 5px 0;
            cursor: pointer;
            font-size: 9pt;
            color: #2c3338;
        }

        .col-option input {
            cursor: pointer;
            accent-color: #3ba38f;
        }

        .btn-col-select {
            display: inline-flex;
            align-items: center;
            padding: 10px 15px;
            background-color: white;
            color: #64748b;
            text-decoration: none;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            font-weight: 400;
            transition: all 0.2s;
            cursor: pointer;
        }

        .btn-col-select:hover {
            border-color: #3ba38f;
            color: #3ba38f;
        }

        .btn-col-select svg {
            margin-right: 8px;
        }

        /* Web Preview Styles (Simulated A4 Pages) */
        @media screen {
            body {
                background-color: #f1f5f9;
                padding: 40px 0;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 40px;
            }

            .export-container {
                width: 90%;
                max-width: 297mm; /* Max landscape width */
                margin-bottom: 0px;
                background: white;
                padding: 15px 25px;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            }

            .summary-page, .day-container {
                background-color: white;
                box-shadow: 0 10px 25px rgba(0,0,0,0.1);
                box-sizing: border-box;
                position: relative;
                margin: 0;
                overflow: hidden;
            }

            .summary-page {
                width: 210mm;
                min-height: 297mm;
                padding: 2cm;
            }

            .summary-page::after {
                content: "Seite 1";
                position: absolute;
                bottom: 1cm;
                left: 50%;
                transform: translateX(-50%);
                font-size: 10pt;
                color: #64748b;
            }

            .day-container {
                width: 297mm;
                min-height: 210mm;
                padding: 1.5cm;
            }

            /* Simulation of page numbering on screen */
            .day-container::after {
                content: "Seite " attr(data-page-index);
                position: absolute;
                bottom: 1cm;
                left: 50%;
                transform: translateX(-50%);
                font-size: 10pt;
                color: #64748b;
            }
        }

    </style>
</head>
<body>

    <div class="export-container no-print">
        <div style="display: flex; gap: 10px; align-items: center;">
            <a href="{% url 'meal-plan-detail' plan.id %}" class="back-link" target="_top">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"></line>
                    <polyline points="12 19 5 12 12 5"></polyline>
                </svg>
                Zurück zum Plan
            </a>

            <div class="col-select-container">
                <button class="btn-col-select" id="colSelectBtn">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7"></rect>
                        <rect x="14" y="3" width="7" height="7"></rect>
                        <rect x="14" y="14" width="7" height="7"></rect>
                        <rect x="3" y="14" width="7" height="7"></rect>
                    </svg>
                    Nährwerte auswählen
                </button>
                <div class="col-select-dropdown" id="colDropdown">
                    {% for nutrient in all_nutrients %}
                        {% if nutrient.key != 'energy_in_kcal' %}
                        <label class="col-option">
                            <input type="checkbox" data-key="{{ nutrient.key }}" {% if nutrient.key in plan.visible_nutrients %}checked{% endif %}>
                            {{ nutrient.label }}
                        </label>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
        <a href="{% url 'meal-plan-pdf' plan.id %}" class="export-button">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            PDF Export
        </a>
    </div>

    <!-- Summary Page -->
    <div class="summary-page">
        <h1>Planübersicht: {{ plan.name }}</h1>
        <p><strong>Durchschnittliche Aufnahme pro Tag</strong> (über {{ days_count }} Tage)</p>
        
        <table class="summary-table">
            <thead>
                <tr>
                    <th>Wert</th>
                    <th class="text-right">Durchschnitt</th>
                    <th class="text-center">Einheit</th>
                    <th>Referenz</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for nutrient in summary_nutrients %}
                <tr>
                    <td>{{ nutrient.label }}</td>
                    <td class="num-right">{{ nutrient.value|floatformat:1 }}</td>
                    <td class="unit-col">{{ nutrient.unit }}</td>
                    <td class="num-left">
                        {% if nutrient.threshold_label %}
                            {{ nutrient.threshold_label }}
                        {% else %}
                            -
                        {% endif %}
                    </td>
                    <td>
                        <div class="bar-container">
                            <div class="bar {% if nutrient.is_ok %}bar-ok{% else %}bar-alert{% endif %}" style="width: {{ nutrient.percentage }}%;"></div>
                        </div>
                        <span class="{% if nutrient.is_ok %}status-ok{% else %}status-alert{% endif %}">
                            {{ nutrient.percentage }}%
                        </span>

                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Day Pages -->
    {% for day in days_data %}
    <div class="day-container" data-page-index="{{ forloop.counter|add:1 }}">
        <h1>{{ day.name }}</h1>
        
        {% for meal_type, foods in day.meals.items %}
            {% if foods %}
            <h3>{{ meal_type }}</h3>
            <table class="day-table">
                <thead>
                    <tr>
                        <th style="width: auto; min-width: 100px;">Lebensmittel</th>
                        <th style="width: 60px;" class="text-center">Menge (g)</th>
                        {% for nutrient in visible_nutrients %}
                            <th class="text-right" style="width: 50px;">{{ nutrient.label }}<br><small>({{ nutrient.unit }})</small></th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for item in foods %}
                    <tr>
                        <td>{{ item.food.name }}</td>
                        <td class="text-center">{{ item.amount_in_g }}</td>
                        {% for nutrient in visible_nutrients %}
                            <td class="text-right">{{ item.nutrients|get_item:nutrient.key|floatformat:1 }}</td>
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% endif %}
        {% endfor %}

        <!-- Daily Totals could go here if needed, but wasn't explicitly requested for the day detail pages, only summary on top. 
             However, "Each day of the meal plan also got a static table..." usually implies just the list. 
             I'll stick to the list. -->
    </div>
    {% endfor %}

    <script>
        const PLAN_ID = "{{ plan.id }}";
        const CSRF_TOKEN = "{{ csrf_token }}";

        document.getElementById('colSelectBtn').addEventListener('click', (e) => {
            e.stopPropagation();
            document.getElementById('colDropdown').classList.toggle('active');
        });

        document.addEventListener('click', (e) => {
            if (!e.target.closest('#colDropdown')) {
                document.getElementById('colDropdown').classList.remove('active');
            }
        });

        document.querySelectorAll('.col-option input').forEach(input => {
            input.addEventListener('change', async (e) => {
                const visibleNutrients = Array.from(document.querySelectorAll('.col-option input:checked'))
                                              .map(i => i.dataset.key);
                
                // Add energy_in_kcal if it's not there, as it's usually mandatory/special
                if (!visibleNutrients.includes('energy_in_kcal')) {
                    // But wait, energy_in_kcal is excluded from the list in HTML, 
                    // should we add it here explicitly?
                }

                try {
                    const response = await fetch(`/api/mealplans/${PLAN_ID}/`, {
                        method: 'PATCH',
                        headers: { 
                            'Content-Type': 'application/json', 
                            'X-CSRFToken': CSRF_TOKEN 
                        },
                        body: JSON.stringify({ visible_nutrients: visibleNutrients })
                    });
                    
                    if (response.ok) {
                        // Reload to update the tables
                        window.location.reload();
                    }
                } catch (e) { console.error(e); }
            });
        });
    </script>
</body>
</html>
