{% extends 'meals/base.html.j2' %}
{% load static i18n sass_tags %}

{% block title %}{% trans "Login" %} | Modern Nutrition{% endblock %}

{% block extra_css %}
    <link rel="stylesheet" href="{% sass_src 'meals/scss/login.scss' %}">
{% endblock %}

{% block content %}
    <div class="login-card">
        <header>
            <h1>{% trans "Login" %}</h1>
            <p class="subtitle">{% trans "Welcome back to Modern Nutrition" %}</p>
        </header>

        <form method="post" action="{% url 'login' %}">
            {% csrf_token %}

            {% if form.non_field_errors %}
            <div class="non-field-errors">
                {{ form.non_field_errors }}
            </div>
            {% endif %}

            <div class="form-group">
                <label for="{{ form.username.id_for_label }}">{% trans "Username" %}</label>
                {{ form.username }}
                {% if form.username.errors %}
                {{ form.username.errors }}
                {% endif %}
            </div>

            <div class="form-group">
                <label for="{{ form.password.id_for_label }}">{% trans "Password" %}</label>
                {{ form.password }}
                {% if form.password.errors %}
                {{ form.password.errors }}
                {% endif %}
            </div>

            <button type="submit" class="btn-login">{% trans "Sign In" %}</button>
            
            <input type="hidden" name="next" value="{{ next }}">
        </form>
    </div>
{% endblock %}
