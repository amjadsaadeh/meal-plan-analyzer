{% extends 'meals/base.html.j2' %}
{% load static i18n sass_tags %}

{% block title %}{% trans "Meal Plans" %} | Modern Nutrition{% endblock %}

{% block extra_css %}
    <link rel="stylesheet" href="{% sass_src 'meals/scss/mealplan_list.scss' %}">
{% endblock %}

{% block content %}
<div class="container" style="max-width: 900px;">
    <header>
        <h1>{% trans "Meal Plans" %}</h1>
    </header>
    <div
        id="meal-plan-app"
        data-csrf-token="{{ csrf_token }}"
        data-create-url="{% url 'meal-plan-create' %}"
        data-i18n='{"confirmDelete": "{% trans "Are you sure you want to delete this meal plan?" %}", "errorDelete": "{% trans "Error deleting plan" %}", "noData": "{% trans "No meal plans found." %}", "noDays": "{% trans "No days" %}", "searchPlaceholder": "{% trans "Search plans..." %}", "createPlan": "{% trans "Create New Plan" %}", "colName": "{% trans "Name" %}", "colDays": "{% trans "Days" %}", "colCreated": "{% trans "Created" %}", "colChanged": "{% trans "Last Changed" %}", "deleteModalTitle": "{% trans "Delete Meal Plan" %}", "deleteModalHint": "{% trans "This action cannot be undone." %}", "cancel": "{% trans "Cancel" %}", "deleteBtn": "{% trans "Delete" %}"}'
    ></div>
</div>
{% endblock %}

{% block extra_js %}
{% load django_vite %}
{% vite_asset 'frontend/src/mealplan-list/main.js' %}
{% endblock %}
