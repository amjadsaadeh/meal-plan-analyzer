{% extends 'meals/base.html.j2' %}
{% load static %}

{% block title %}Meal Plans | Modern Nutrition{% endblock %}

{% block extra_css %}
    <style>
        body {
            align-items: center;
            padding-top: 0; /* Handled by top-bar and container padding */
        }

        header {
            text-align: center;
            margin-bottom: 3rem;
        }

        h1 {
            font-size: 3rem;
            font-weight: 400;
            background: linear-gradient(135deg, #64d2bd 0%, #4a4e51 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.5rem;
        }

        .top-actions {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            align-items: center;
        }

        .btn-create {
            display: inline-flex;
            align-items: center;
            padding: 0.8rem 1.5rem;
            background: var(--primary);
            color: white;
            text-decoration: none;
            border-radius: 12px;
            font-weight: 400;
            transition: all 0.3s ease;
            box-shadow: 0 4px 10px var(--primary-glow);
            border: none;
            cursor: pointer;
            white-space: nowrap;
        }

        .btn-create:hover {
            background: var(--primary-hover);
            transform: translateY(-2px);
            box-shadow: 0 6px 15px var(--primary-glow);
        }

        .search-wrapper {
            position: relative;
            flex-grow: 1;
        }

        .search-bar {
            width: 100%;
            padding: 0.8rem 1.2rem;
            background: #ffffff;
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            color: var(--text-main);
            font-size: 1rem;
            outline: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: var(--shadow);
        }

        .search-bar:focus {
            border-color: var(--primary);
            box-shadow: 0 0 15px var(--primary-glow);
        }

        .table-card {
            background: var(--card-bg);
            backdrop-filter: blur(12px);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th {
            padding: 1.2rem 1.5rem;
            font-weight: 600;
            color: var(--text-dim);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            border-bottom: 1px solid var(--glass-border);
        }

        td {
            padding: 1.2rem 1.5rem;
            border-bottom: 1px solid var(--glass-border);
            font-size: 1rem;
            transition: background 0.2s;
        }

        tr:last-child td {
            border-bottom: none;
        }

        .meal-plan-row {
            cursor: pointer;
        }

        .meal-plan-row:hover td {
            background: var(--row-hover);
        }

        .meal-plan-name {
            font-weight: 400;
            color: var(--text-main);
        }

        .date-cell {
            color: var(--text-dim);
            font-size: 0.9rem;
        }

        .pagination {
            display: flex;
            justify-content: center;
            gap: 0.5rem;
            padding: 1.5rem;
            align-items: center;
        }

        .page-link {
            padding: 0.5rem 1rem;
            border-radius: 8px;
            text-decoration: none;
            color: var(--text-dim);
            transition: all 0.2s;
            border: 1px solid transparent;
        }

        .page-link:hover {
            background: var(--glass-border);
            color: var(--text-main);
        }

        .page-link.active {
            background: var(--primary);
            color: white;
            font-weight: 400;
        }

        .page-link.disabled {
            opacity: 0.3;
            pointer-events: none;
        }

        .no-data {
            padding: 3rem;
            text-align: center;
            color: var(--text-dim);
        }

        @media (max-width: 600px) {
            .top-actions {
                flex-direction: column;
                align-items: stretch;
            }

            th:nth-child(3),
            td:nth-child(3) {
                display: none;
            }
        }

        .delete-btn {
            color: var(--text-dim);
            padding: 8px;
            border-radius: 8px;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            background: transparent;
            cursor: pointer;
        }

        .delete-btn:hover {
            color: #ef4444;
            background: rgba(239, 68, 68, 0.1);
        }

        .actions-cell {
            width: 50px;
            text-align: center;
        }

        .energy-badge {
            background: rgba(59, 163, 143, 0.1);
            padding: 4px 10px;
            border-radius: 8px;
            font-size: 0.8rem;
            color: #2d8170;
            white-space: nowrap;
            font-weight: 400;
            transition: all 0.2s;
        }

        .energy-badge:hover {
            background: var(--primary);
            color: white;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="container" style="max-width: 900px;">
        <header>
            <h1>Meal Plans</h1>
        </header>

        <div class="top-actions">
            <a href="{% url 'meal-plan-create' %}" class="btn-create">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Create New Plan
            </a>
            <div class="search-wrapper">
                <input type="text" name="search" class="search-bar" placeholder="Search plans..." value="{{ search_query }}" autocomplete="off" id="liveSearch">
            </div>
        </div>

        <div class="table-card">
            <table>
                <thead>
                    <tr>
                        <th style="width: 40px;"></th>
                        <th>Name</th>
                        <th>Days</th>
                        <th>Created</th>
                        <th>Last Changed</th>
                        <th class="actions-cell"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for plan in page_obj %}
                    <tr class="meal-plan-row" data-url="{% url 'meal-plan-detail' plan.pk %}" onclick="location.href=this.dataset.url">
                        <td>
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                        </td>
                        <td class="meal-plan-name" data-name="{{ plan.name }}">{{ plan.name }}</td>
                        <td>
                            <div style="display: flex; gap: 4px; flex-wrap: wrap;">
                                {% for day in plan.days.all %}
                                <a href="{% url 'meal-plan-detail' plan.pk %}#day-{{ day.id }}" class="energy-badge" style="text-decoration: none;" onclick="event.stopPropagation()">
                                    {{ day.name }}
                                </a>
                                {% empty %}
                                <span class="no-data" style="padding: 0; font-size: 0.8rem;">No days</span>
                                {% endfor %}
                            </div>
                        </td>
                        <td class="date-cell">{{ plan.creation_date|date:"M d, Y" }}</td>
                        <td class="date-cell">{{ plan.change_date|date:"M d, Y H:i" }}</td>
                        <td class="actions-cell">
                            <button class="delete-btn" onclick="deletePlan(event, '{{ plan.pk }}')">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"></polyline>
                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                    </path>
                                    <line x1="10" y1="11" x2="10" y2="17"></line>
                                    <line x1="14" y1="11" x2="14" y2="17"></line>
                                </svg>
                            </button>
                        </td>
                    </tr>
                    {% empty %}
                    <tr>
                        <td colspan="6" class="no-data">No meal plans found.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if page_obj.has_other_pages %}
            <div class="pagination">
                {% if page_obj.has_previous %}
                <a href="?page={{ page_obj.previous_page_number }}{% if search_query %}&search={{ search_query }}{% endif %}" class="page-link">&laquo;</a>
                {% else %}
                <span class="page-link disabled">&laquo;</span>
                {% endif %}

                {% for num in page_obj.paginator.page_range %}
                {% if page_obj.number == num %}
                <span class="page-link active">{{ num }}</span>
                {% elif num > page_obj.number|add:'-3' and num < page_obj.number|add:'3' %} <a href="?page={{ num }}{% if search_query %}&search={{ search_query }}{% endif %}" class="page-link">
                    {{ num }}</a>
                    {% endif %}
                    {% endfor %}

                    {% if page_obj.has_next %}
                    <a href="?page={{ page_obj.next_page_number }}{% if search_query %}&search={{ search_query }}{% endif %}" class="page-link">&raquo;</a>
                    {% else %}
                    <span class="page-link disabled">&raquo;</span>
                    {% endif %}
            </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block extra_js %}
    <script>
        function highlightMatch(text, query) {
            if (!query) return text;
            const semanticKeywords = ['low', 'high', 'energy', 'cal', 'kcal', 'kj'];
            const tokens = query.toLowerCase().split(/\s+/)
                .filter(t => t.length >= 2 && !semanticKeywords.includes(t));
            if (tokens.length === 0) return text;
            const pattern = tokens.map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|');
            if (!pattern) return text;
            const regex = new RegExp(`(${pattern})`, 'gi');
            return text.replace(regex, '<strong>$1</strong>');
        }

        document.addEventListener('DOMContentLoaded', () => {
            const searchInput = document.getElementById('liveSearch');
            let searchTimeout;

            const initialQuery = searchInput.value;
            if (initialQuery) {
                applyHighlights(initialQuery);
            }

            searchInput.addEventListener('input', (e) => {
                clearTimeout(searchTimeout);
                const query = e.target.value.trim();

                searchTimeout = setTimeout(() => {
                    updateResults(query);
                }, 300);
            });

            // Prevent enter from submitting
            searchInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') e.preventDefault();
            });

            // Handle pagination clicks
            document.addEventListener('click', (e) => {
                const link = e.target.closest('.pagination a');
                if (link) {
                    e.preventDefault();
                    const url = link.getAttribute('href');
                    const urlParams = new URLSearchParams(url.split('?')[1]);
                    updateResults(searchInput.value.trim(), urlParams.get('page'));
                }
            });
        });

        async function updateResults(query, page = null) {
            const url = new URL(window.location.href);
            url.searchParams.set('search', query);
            if (page) {
                url.searchParams.set('page', page);
            } else {
                url.searchParams.delete('page');
            }

            try {
                const response = await fetch(url);
                const html = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');

                // Update table card
                const newCard = doc.querySelector('.table-card');
                document.querySelector('.table-card').innerHTML = newCard.innerHTML;

                // Update URL without reload
                window.history.pushState({}, '', url);

                // Re-apply highlights
                applyHighlights(query);
            } catch (error) {
                console.error('Error fetching results:', error);
            }
        }

        function applyHighlights(query) {
            if (!query) return;
            document.querySelectorAll('.meal-plan-name').forEach(el => {
                const originalName = el.getAttribute('data-name');
                el.innerHTML = highlightMatch(originalName, query);
            });
        }

        async function deletePlan(event, pk) {
            event.stopPropagation();
            if (!confirm('Are you sure you want to delete this meal plan?')) return;

            try {
                const response = await fetch(`/api/mealplans/${pk}/`, {
                    method: 'DELETE',
                    headers: {
                        'X-CSRFToken': '{{ csrf_token }}'
                    }
                });
                if (response.ok) {
                    const searchInput = document.getElementById('liveSearch');
                    updateResults(searchInput.value.trim());
                } else {
                    alert('Error deleting plan');
                }
            } catch (error) {
                console.error('Error:', error);
            }
        }
    </script>
{% endblock %}