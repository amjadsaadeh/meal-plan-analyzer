# Vite dev server (only needed when accessing Django from a non-localhost device)
# Set to the IP/hostname of the machine running pnpm dev
# VITE_DEV_SERVER_HOST=localhost
# VITE_ORIGIN=http://localhost:5173

# Django application settings
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-domain.com,another-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://another-domain.com
DATABASE_URL=postgres://user:password@db:5432/dbname

# Async task queue (Celery + Redis)
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/1

# WeasyPrint base URL (used by Celery worker — no request context available)
SITE_BASE_URL=http://localhost:8000

# Deployment: Docker image (registry/image:tag)
DOCKER_IMAGE=ghcr.io/your-username/meal-plan-analyzer:latest
DOCKER_USER=<your docker username>
DOCKER_PASSWORD=<your docker PAT>

# Deployment: DNS and server addresses
TLD=your-domain.com
MEALPLANALYZER_IPV4_ADDR=1.2.3.4
MEALPLANALYZER_IPV6_ADDR=::1

# Deployment: Ansible vault ID (entry name in your KeePass database)
ANSIBLE_VAULT_ID=your-vault-entry-name

# Ansible vault password retrieval via KeePassXC CLI
DOCKER_BUILDKIT=1
KEEPASS_CMD=keepassxc-cli
KEEPASS_DB_PATH=<path to your keepass database>
